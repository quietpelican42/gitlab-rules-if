{
  "name": "gitlab-rules-if",
  "version": "0.1.0",
  "description": "Evaluate GitLab CI rules:if and only:variables expressions the way GitLab does, including RE2 regex semantics. Zero dependencies.",
  "keywords": [
    "gitlab",
    "gitlab-ci",
    "rules",
    "rules-if",
    "only-variables",
    "expression",
    "evaluator",
    "re2",
    "parser"
  ],
  "license": "MIT",
  "author": "__AUTHOR__",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/__GH_OWNER__/gitlab-rules-if.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE-gitlab"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run test:dist",
    "test:dist": "node --test test/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
